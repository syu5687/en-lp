# =====================================================================
# 縁 マルチLP — ルート .htaccess
# 設置: Cloud Run / / (DocumentRoot)
# =====================================================================

Options +FollowSymLinks -MultiViews
DirectoryIndex index.html index.php

# ----- リダイレクト/リライト -----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ルートアクセス時はお墓じまいLPへ（メインLP）
  RewriteRule ^$ /ohaka/ [R=302,L]
</IfModule>

# ----- gzip / deflate 圧縮 -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ----- ブラウザキャッシュ -----
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType text/html                 "access plus 1 hour"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/xml                  "access plus 1 day"
  ExpiresDefault                          "access plus 1 week"
</IfModule>

# ----- Cache-Control ヘッダ -----
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # ----- セキュリティヘッダ -----
  Header always set X-Content-Type-Options       "nosniff"
  Header always set X-Frame-Options              "SAMEORIGIN"
  Header always set Referrer-Policy              "strict-origin-when-cross-origin"
  Header always set Permissions-Policy           "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security    "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ----- 文字エンコーディング -----
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json

# ----- 不要ファイルへのアクセス禁止 -----
<FilesMatch "^(\.|Dockerfile|cloudbuild\.yaml|README\.md|CHANGELOG\.md|VERSION)">
  Require all denied
</FilesMatch>

# ----- 各LP配下の404は各LPのindex.htmlへ -----
ErrorDocument 404 /ohaka/
