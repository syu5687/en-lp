# ============================================================
# 有限会社 縁 — URL正規化・旧サイト（WordPress）からの 301 リダイレクト
# 目的：リニューアル前 en1150.co.jp のURL評価（SEO）を新サイトへ引き継ぐ。
#   1) HTTPS強制 ＋ www→非www 正規化
#   2) 旧・固定ページURL → 対応する新ページへ 301
#   3) 旧・ブログ記事URL（ルート直下 /<slug>/）→ /blog/?id=<slug> へ 301
#      （実ファイル・実ディレクトリが無い単一セグメントのみ blog-redirect.php に委譲）
# ※ 反映には Apache の mod_rewrite が必要です
#   （Dockerfile で `a2enmod rewrite headers expires` を有効化してください）。
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- 1) HTTPS 強制（プロキシ経由も考慮）----
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ---- 1b) www → 非www 正規化 ----
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # ---- 1c) ディレクトリURLの末尾スラッシュ補完（絶対URLで1ホップ301）----
  # Apache 既定の DirectorySlash は Cloud Run の待受ポート(:8080)付きURLを生成して
  # しまうため、先に自前で正規URLへ 301 する。
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://en1150.co.jp/$1/ [R=301,L]

  # ---- 2) 旧・固定ページ → 新ページ（301）----
  # 統合・名称変更されたページ
  RewriteRule ^powder/?$                 https://en1150.co.jp/powder-cleaning/ [R=301,L]
  RewriteRule ^cleaning/?$               https://en1150.co.jp/powder-cleaning/ [R=301,L]
  RewriteRule ^retaliation/?$            https://en1150.co.jp/temoto-kuyou/    [R=301,L]
  RewriteRule ^retaliation-accessory/?$  https://en1150.co.jp/temoto-kuyou/    [R=301,L]
  RewriteRule ^shizen-sou/?$             https://en1150.co.jp/kaiyou-sou/      [R=301,L]
  RewriteRule ^charter-kaiyou-sou/?$     https://en1150.co.jp/kaiyou-sou/      [R=301,L]
  RewriteRule ^goudou/?$                 https://en1150.co.jp/kaiyou-sou/      [R=301,L]
  RewriteRule ^goudou-kaiyou-sou/?$      https://en1150.co.jp/kaiyou-sou/      [R=301,L]
  RewriteRule ^itaku-kaiyou-sou/?$       https://en1150.co.jp/kaiyou-sou/      [R=301,L]
  RewriteRule ^memorial-cruise/?$        https://en1150.co.jp/kaiyou-sou/      [R=301,L]
  RewriteRule ^letter/?$                 https://en1150.co.jp/kaiyou-sou/      [R=301,L]
  RewriteRule ^message/?$                https://en1150.co.jp/company/         [R=301,L]
  RewriteRule ^grave-test/?$             https://en1150.co.jp/ihinseiri/       [R=301,L]
  RewriteRule ^contact/contact-lec/?$    https://en1150.co.jp/contact/         [R=301,L]
  RewriteRule ^sample-page/?$            https://en1150.co.jp/                 [R=301,L]

  # ※ かつて ^kaiyou-sou/fukuoka/ → /fukuoka/ の301を置いていたが、v0246 で
  #    /kaiyou-sou/fukuoka/（福岡の海洋散骨専門ページ）を正式公開したため削除した。
  #    役割分担：/fukuoka/=福岡営業所の総合ハブ／/kaiyou-sou/fukuoka/=海洋散骨特化。
  #    301はブラウザに恒久キャッシュされるため、確認時は ?cb=1 等を付けて検証すること。

  # ---- 旧WordPressアーカイブURL（カテゴリ・タグ・日付）→ 301 で新ページへ集約 ----
  #  内部リンク評価の引き継ぎ用。カテゴリ「お客様の声」だけは /voice/ へ1対1で継承。
  RewriteRule ^category/お客様の声/?$    https://en1150.co.jp/voice/           [R=301,L]
  RewriteRule ^category/                 https://en1150.co.jp/blog/            [R=301,L]
  RewriteRule ^tag/                      https://en1150.co.jp/blog/            [R=301,L]
  RewriteRule ^[0-9]{4}/[0-9]{2}(/[0-9]{2})?/?$ https://en1150.co.jp/blog/     [R=301,L]

  # ---- 2b) 画像配信（Cloud Storage プロキシ・管理画面アップロード分）----
  RewriteRule ^img/(.+)$ /img.php?p=$1 [L,B]

  # ---- 2c) サイトマップ（検索エンジン登録用の正式URL）----
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]

  # ---- 3) 旧・ブログ記事（ルート直下 /<slug>/）→ blog-redirect.php で 301 判定 ----
  # 実ファイル／実ディレクトリが存在しない「単一セグメント」のみ委譲する。
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^/]+)/?$ /blog-redirect.php [L]
</IfModule>

# ============================================================
# 静的アセットのキャッシュ設定
# CSS/JS/画像は URL に ?v=バージョン を付けているため、長期キャッシュしても
# 更新時は必ず新URLとして再取得されます（＝安全にキャッシュ有効化できます）。
# 構築中（DEV_MODE=true）は ?v=時刻 で毎回URLが変わるため、実質キャッシュされません。
# HTMLのキャッシュ可否は PHP 側（includes/config.php）で制御します。
# ============================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|avif|svg|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/gif                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>
