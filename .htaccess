# ====================================================================
# 縁 お墓じまいLP - .htaccess
# パフォーマンス + SEO + セキュリティ最適化
# ====================================================================

# ----- gzip / deflate 圧縮 -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ----- ブラウザキャッシュ -----
<IfModule mod_expires.c>
  ExpiresActive On

  # 画像（長期キャッシュ）
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  # フォント
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"

  # CSS / JS（中期キャッシュ）
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"

  # HTML（短期：内容更新を素早く反映）
  ExpiresByType text/html                 "access plus 1 hour"

  # XML（sitemap等）
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/xml                  "access plus 1 day"

  # デフォルト
  ExpiresDefault                          "access plus 1 week"
</IfModule>

# ----- Cache-Control ヘッダ -----
<IfModule mod_headers.c>
  # 画像・フォントは immutable で長期キャッシュ
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML は短期キャッシュ
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # ----- セキュリティヘッダ -----
  Header always set X-Content-Type-Options       "nosniff"
  Header always set X-Frame-Options              "SAMEORIGIN"
  Header always set Referrer-Policy              "strict-origin-when-cross-origin"
  Header always set Permissions-Policy           "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security    "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ----- 文字エンコーディング -----
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json

# ----- リダイレクト/リライト -----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # index.html を URL から非表示にする（任意）
  # RewriteCond %{THE_REQUEST} \s/+(.*?)/?index\.html [NC]
  # RewriteRule ^ /%1 [R=301,L]
</IfModule>

# ----- 不要ファイルへのアクセス禁止 -----
<FilesMatch "^(\.|Dockerfile|cloudbuild\.yaml|README\.md|CHANGELOG\.md|VERSION)">
  Require all denied
</FilesMatch>

# ----- 404エラーハンドリング -----
ErrorDocument 404 /index.html
